<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel</title>
  <style>
    :root {
      --bg: #0f0e0c;
      --surface: #16213e;
      --card: #1a1a2e;
      --border: #2a2a4a;
      --accent: #f4a623;
      --accent2: #f97316;
      --text: #f0ece4;
      --muted: #a0a0b0;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      padding-bottom: 40px;
    }

    span {
      color: var(--accent2);
    }

    nav {
      background-color: var(--surface);
      padding: 15px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--accent2);
      margin-bottom: 32px;
    }

    h1, a {
      color: var(--text);
      font-family: 'Segoe UI', sans-serif;
      text-decoration: none;
      font-size: x-large;
      font-weight: 700;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .card {
      background: var(--card);
      padding: 24px 20px;
      border-radius: 10px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.35);
      border: 1px solid var(--border);
      border-top: 3px solid var(--accent);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.45);
    }

    .card h3 {
      margin-bottom: 16px;
      font-size: 1.1rem;
      border-bottom: 2px solid var(--accent);
      padding-bottom: 8px;
      color: var(--accent);
    }

    input, select, textarea {
      width: 100%;
      padding: 10px 12px;
      margin: 8px 0;
      background: var(--bg);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 6px;
      font-family: inherit;
      font-size: 0.9rem;
      transition: border-color 0.2s;
    }

    input::placeholder, textarea::placeholder {
      color: var(--muted);
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--accent);
    }

    .field-label {
      display: block;
      margin-top: 8px;
      font-size: 0.8rem;
      color: var(--muted);
    }

    input[type="file"] {
      padding: 8px;
      cursor: pointer;
    }

    input[type="file"]::file-selector-button {
      background: var(--accent);
      color: #000;
      border: none;
      border-radius: 4px;
      padding: 6px 12px;
      margin-right: 10px;
      font-weight: 600;
      cursor: pointer;
    }

    button {
      width: 100%;
      padding: 10px;
      background: var(--accent);
      color: #000;
      border: none;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      margin-top: 10px;
      transition: background 0.2s, transform 0.1s;
    }

    button:hover { background: #ffb83d; transform: scale(1.01); }

    /* Orders section */
    .stat-box {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 16px;
      text-align: center;
      margin: 8px 0;
    }

    .stat-box .number {
      font-size: 2.5rem;
      font-weight: bold;
      display: block;
      color: var(--accent);
    }

    .stat-box .label {
      font-size: 0.9rem;
      margin-top: 4px;
      display: block;
      color: var(--muted);
    }

    @media (max-width: 700px) {
      .grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <nav>
        <a href="/" class="logo">Food<span>iez</span></a>
        <h1><span>Admin</span> Panel</h1>
  </nav>

  <div class="grid">

    <!-- Add new Item -->
    <div class="card">
      <form action="/admin/new-item" method="post" enctype="multipart/form-data">

        <h3>Add Item</h3>

        <input placeholder="item name" name="name" type="text" required>
        <input placeholder="price" name="price" type="number" required>

        <select name="category">
          <% ['Indian','chinese','italian','dessert','drinks'].forEach(cat => { %>
              <option value="<%= cat %>"><%= cat %></option>
          <% }) %>
        </select>

        <select name="type">
          <option value="veg">Veg</option>
          <option value="nonveg">Non-veg</option>
        </select>

        <input placeholder="discription" name="desc" type="text" required>

        <label class="field-label">Item image
          <input name="image" type="file" accept="image/*">
        </label>

        <button>Add Item</button>

      </form>
    </div>

    <!-- Item Edit -->
    <div class="card">
      <form action="/admin/items" method="post" enctype="multipart/form-data">

          <h3>Edit Item</h3>
        <select name="itemId">
          <% items.forEach(item => { %>
              <option value="<%= item._id %>"><%= item.name %></option>
          <% }) %>
        </select>
        <input name="name" type="text" placeholder="Item Name">
        <input name="price" type="number" placeholder="Price">

        <select name="type">
          <option value="veg">Veg</option>
          <option value="nonveg">Non-veg</option>
        </select>

        <select name="category">
          <% ['Indian','chinese','italian','dessert','drinks'].forEach(cat => { %>
              <option value="<%= cat %>"><%= cat %></option>
          <% }) %>
        </select>

        <label class="field-label">New image (leave empty to keep current)
          <input name="image" type="file" accept="image/*">
        </label>

        <textarea name="desc" rows="3" placeholder="Description"></textarea>
        
      <button>Update Item</button>

      </form>
    </div>

    <!--  Add Offer -->
    <div class="card">

      <form action="/admin/offers" method="POST">

        <h3>Add Offer</h3>
        <input name="specialOccasion" type="text" placeholder="Offer Title" required>
        <input name="discountPercent" type="number" placeholder="Discount (%)" required>
        <input name="minimumOrderValue" type="number" placeholder="minimum order value">
        
        <select name="freeItem">
          <option value="">No free item</option>
          <% items.forEach(item => { %>
            <option value="<%= item.name %>"><%= item.name %></option>
          <% }) %>
        </select>

        <select name="applicableOn">
          <option value="">Applicable on (all items)</option>
          <% items.forEach(item => { %>
            <option value="<%= item.name %>"><%= item.name %></option>
          <% }) %>
        </select>

        <input name="expiryDate" type="date" placeholder="Expiry Date">
        <button>Add Offer</button>

      </form>

    </div>

    <!-- Orders -->
    <div class="card">

      <h3>Orders Overview</h3>

      <div class="stat-box">
        <span class="number"><%= totalOrders %></span>
        <span class="label">Total Orders</span>
      </div>

      <div class="stat-box">
        <span class="number"><%= pending %></span>
        <span class="label">Pending</span>
      </div>

      <div class="stat-box">
        <span class="number"><%= delivered %></span>
        <span class="label">Delivered</span>

      </div>

    </div>

  </div>

  <script>
    // prefill the Edit Item form with the selected item's current values
    const menuItems = <%- JSON.stringify(items) %>;
    const editForm = document.querySelector('form[action="/admin/items"]');
    const editSelect = editForm.querySelector('select[name="itemId"]');

    function prefillEdit() {
      const item = menuItems.find(i => i._id === editSelect.value);
      if (!item) return;
      editForm.querySelector('input[name="name"]').value = item.name || '';
      editForm.querySelector('input[name="price"]').value = item.price != null ? item.price : '';
      editForm.querySelector('select[name="type"]').value = item.type || 'veg';
      editForm.querySelector('select[name="category"]').value = item.category || 'Indian';
      editForm.querySelector('textarea[name="desc"]').value = item.desc || '';
    }

    editSelect.addEventListener('change', prefillEdit);
    prefillEdit();
  </script>

</body>
</html>
