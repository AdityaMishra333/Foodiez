<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Offers - Foodiez</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #1a1a2e;
            color: #ffffff;
            min-height: 100vh;
        }

        nav {
            background-color: #16213e;
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #f97316;
        }

        nav .logo {
            font-size: 1.6rem;
            font-weight: 700;
            color: #f97316;
            text-decoration: none;
        }

        nav .logo span {
            color: #ffffff;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 30px;
        }

        nav ul li a {
            text-decoration: none;
            color: #ffffff;
            font-weight: 500;
            font-size: 0.95rem;
            transition: color 0.2s;
        }

        nav ul li a:hover,
        nav ul li a.active {
            color: #f97316;
        }

        .page-header {
            text-align: center;
            padding: 50px 20px 30px;
        }

        .page-header h1 {
            font-size: 2.2rem;
            font-weight: 700;
            color: #f97316;
        }

        .page-header p {
            font-size: 0.95rem;
            color: #a0a0b0;
            margin-top: 8px;
        }

        .divider {
            width: 60px;
            height: 3px;
            background-color: #f97316;
            margin: 14px auto 0;
            border-radius: 2px;
        }

        .offers-section {
            padding: 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-label {
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 2px;
            color: #f97316;
            text-transform: uppercase;
            margin-bottom: 16px;
        }

        .featured-offer {
            display: flex;
            align-items: center;
            background-color: #16213e;
            border: 1px solid #2a2a4a;
            border-left: 4px solid #f97316;
            border-radius: 12px;
            padding: 30px 35px;
            margin-bottom: 50px;
            gap: 30px;
        }

        .featured-offer .offer-badge {
            background-color: #f97316;
            color: #ffffff;
            font-size: 2rem;
            font-weight: 700;
            padding: 20px 28px;
            border-radius: 10px;
            white-space: nowrap;
            text-align: center;
            line-height: 1.2;
        }

        .featured-offer .offer-info h2 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 8px;
        }

        .featured-offer .offer-info p {
            font-size: 0.9rem;
            color: #a0a0b0;
            line-height: 1.6;
        }

        .featured-offer .offer-code {
            margin-top: 14px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .offer-code span {
            background-color: #1a1a2e;
            border: 1px dashed #f97316;
            color: #f97316;
            font-size: 0.9rem;
            font-weight: 600;
            padding: 7px 16px;
            border-radius: 6px;
            letter-spacing: 1px;
        }

        .btn-copy {
            background-color: #f97316;
            color: #ffffff;
            border: none;
            padding: 8px 18px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            font-family: 'Poppins', sans-serif;
            transition: background-color 0.2s;
        }

        .btn-copy:hover {
            background-color: #e06310;
        }

        .offers-row-2 {
            display: flex;
            gap: 20px;
            margin-bottom: 50px;
        }

        .offer-card {
            background-color: #16213e;
            border: 1px solid #2a2a4a;
            border-radius: 12px;
            padding: 25px;
            flex: 1;
            position: relative;
            overflow: hidden;
            transition: transform 0.2s, border-color 0.2s;
        }

        .offer-card:hover {
            transform: translateY(-3px);
            border-color: #f97316;
        }

        .offer-card .card-tag {
            font-size: 0.75rem;
            font-weight: 600;
            color: #f97316;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .offer-card h3 {
            font-size: 1.15rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 8px;
        }

        .offer-card p {
            font-size: 0.85rem;
            color: #a0a0b0;
            line-height: 1.6;
            margin-bottom: 16px;
        }

        .offer-card .code-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .offer-card .code-row span {
            background-color: #1a1a2e;
            border: 1px dashed #f97316;
            color: #f97316;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 5px;
            letter-spacing: 1px;
        }

        .offer-card .corner-badge {
            position: absolute;
            top: 0;
            right: 0;
            background-color: #f97316;
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 5px 14px;
            border-radius: 0 12px 0 10px;
        }

        .offers-row-3 {
            display: flex;
            gap: 20px;
            margin-bottom: 50px;
        }

        .offer-card-sm {
            background-color: #16213e;
            border: 1px solid #2a2a4a;
            border-radius: 12px;
            padding: 22px;
            flex: 1;
            transition: transform 0.2s, border-color 0.2s;
        }

        .offer-card-sm:hover {
            transform: translateY(-3px);
            border-color: #f97316;
        }

        .offer-card-sm .sm-tag {
            font-size: 0.72rem;
            font-weight: 600;
            color: #f97316;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .offer-card-sm h4 {
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .offer-card-sm p {
            font-size: 0.82rem;
            color: #a0a0b0;
            line-height: 1.5;
            margin-bottom: 14px;
        }

        .offer-card-sm .sm-code {
            background-color: #1a1a2e;
            border: 1px dashed #f97316;
            color: #f97316;
            font-size: 0.8rem;
            font-weight: 600;
            padding: 5px 12px;
            border-radius: 5px;
            display: inline-block;
            letter-spacing: 1px;
        }

        footer {
            background-color: #16213e;
            border-top: 2px solid #f97316;
            text-align: center;
            padding: 20px;
            color: #a0a0b0;
            font-size: 0.85rem;
            margin-top: 40px;
        }

        footer span {
            color: #f97316;
        }
    </style>
</head>
<body>

    <nav>
        <a href="/" class="logo">Foodi<span>ez</span></a>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/menu">Menu</a></li>
            <li><a href="/offers" class="active">Offers</a></li>
            <li><a href="/cart">Cart</a></li>
            <li><a href="/login">Login</a></li>
            <li><a href="/register">Register</a></li>
        </ul>
    </nav>

    <div class="page-header">
        <h1>🔥 Hot Offers</h1>
        <p>Grab the best deals before they expire!</p>
        <div class="divider"></div>
    </div>

    <div class="offers-section">

        <p class="section-label">Featured Deal</p>
        <div class="featured-offer">
            <div class="offer-badge">30% <br> OFF</div>
            <div class="offer-info">
                <h2>Grand Welcome Offer</h2>
                <p>Get flat 30% off on your first order. Valid on all menu items above ₹299. No minimum order value required for new users.</p>
                <div class="offer-code">
                    <span>WELCOME30</span>
                    <button class="btn-copy" onclick="copyCode('WELCOME30', this)">Copy Code</button>
                </div>
            </div>
        </div>

        <p class="section-label">Limited Time Offers</p>
        <div class="offers-row-2">
            <div class="offer-card">
                <div class="corner-badge">20% OFF</div>
                <p class="card-tag">🕐 Limited</p>
                <h3>Weekend Special</h3>
                <p>Order on Saturday or Sunday and save big. Valid on orders above ₹199.</p>
                <div class="code-row">
                    <span>WEEKEND20</span>
                    <button class="btn-copy" onclick="copyCode('WEEKEND20', this)">Copy</button>
                </div>
            </div>
            <div class="offer-card">
                <div class="corner-badge">15% OFF</div>
                <p class="card-tag">🕐 Limited</p>
                <h3>Combo Bonanza</h3>
                <p>Order any combo meal and get 15% off. Available all week on selected items.</p>
                <div class="code-row">
                    <span>COMBO15</span>
                    <button class="btn-copy" onclick="copyCode('COMBO15', this)">Copy</button>
                </div>
            </div>
        </div>

        <p class="section-label">More Savings</p>
        <div class="offers-row-3">
            <div class="offer-card-sm">
                <p class="sm-tag">🎉 Deal</p>
                <h4>Late Night Bites</h4>
                <p>Ordering after 9 PM? Enjoy 10% off on all orders.</p>
                <span class="sm-code">NIGHT10</span>
            </div>
            <div class="offer-card-sm">
                <p class="sm-tag">🎉 Deal</p>
                <h4>Student Deal</h4>
                <p>Use this code for 12% off. Made for all the broke students out there.</p>
                <span class="sm-code">STUDENT12</span>
            </div>
            <div class="offer-card-sm">
                <p class="sm-tag">🎉 Deal</p>
                <h4>Refer a Friend</h4>
                <p>Refer a friend and both of you get ₹50 off your next order.</p>
                <span class="sm-code">REFER50</span>
            </div>
        </div>

    </div>

    <footer>
        <p>&copy; 2024 <span>Foodiez</span>. All rights reserved.</p>
    </footer>

    <script>
        function copyCode(code, btn) {
            navigator.clipboard.writeText(code).then(() => {
                btn.textContent = 'Copied!';
                btn.style.backgroundColor = '#22c55e';
                setTimeout(() => {
                    btn.textContent = btn.textContent.includes('Copied') ? (btn.textContent === 'Copied!' ? 'Copy Code' : 'Copy') : btn.textContent;
                    btn.style.backgroundColor = '#f97316';
                }, 2000);
            });
        }
    </script>

</body>
</html>
